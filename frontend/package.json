{
  "name": "sme-genius-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "deploy": "vercel --prod",
    "lint": "eslint src scripts video next.config.ts",
    "test": "tsx --test src/lib/server/*.test.ts src/hooks/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "video:render": "remotion render video/index.tsx ScaleUpWalkthrough public/video/scale-up-walkthrough.mp4 --codec=h264 --overwrite && remotion render video/index.tsx ScaleUpWalkthrough public/video/scale-up-walkthrough.webm --codec=vp8 --overwrite && remotion still video/index.tsx ScaleUpWalkthrough public/video/walkthrough-poster.png --frame=1020 --overwrite"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.54.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@remotion/cli": "^4.0.540",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "remotion": "^4.0.540",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^64.7.0"
  }
}
