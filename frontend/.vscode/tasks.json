{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*",
          "endsPattern": ".*Ready in.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Deploy to Vercel (Production)",
      "type": "shell",
      "command": "npm run deploy",
      "problemMatcher": []
    },
    {
      "label": "Build Next.js App",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"]
    }
  ]
}
